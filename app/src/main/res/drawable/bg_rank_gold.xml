<?xml version="1.0" encoding="utf-8"?>
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">

    <!-- Gradient màu vàng kim loại -->
    <!-- startColor: Vàng đậm, centerColor: Vàng sáng, endColor: Vàng đậm -->
    <gradient
        android:angle="45"
        android:startColor="#FFC107"
        android:centerColor="#FFF59D"
        android:endColor="#FFB300"
        android:type="linear" />

    <!-- Bo góc cho khớp với CardView bên ngoài -->
    <corners android:radius="16dp" />
</shape>
