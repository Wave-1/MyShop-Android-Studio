<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:tools="http://schemas.android.com/tools"
    android:background="#F5F5F5"
    android:fitsSystemWindows="true"
    android:orientation="vertical"
    tools:context=".Activities.PaymentMethodActivity">

    <!-- Toolbar -->
    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/appBarLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="@drawable/bg_header_gradient"
            android:textSize="20sp"
            android:textStyle="bold"
            app:navigationIcon="@drawable/ic_arrow_back"
            app:navigationIconTint="?attr/colorOnPrimary"
            app:title="Chi tiết đơn hàng"
            app:titleTextColor="?attr/colorOnPrimary" />
    </com.google.android.material.appbar.AppBarLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <RadioGroup
            android:id="@+id/radioGroupPayment"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="16dp">

            <!-- Lựa chọn 1: COD -->
            <RadioButton
                android:id="@+id/rbCOD"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_white_rounded"
                android:buttonTint="@color/purple_500"
                android:drawableStart="@drawable/ic_money"
                android:drawablePadding="12dp"
                android:padding="16dp"
                android:layout_marginBottom="12dp"
                android:text="Thanh toán khi nhận hàng (COD)"
                android:textColor="@color/black"
                android:textSize="16sp" />

            <!-- Lựa chọn 2: Google Pay -->
            <RadioButton
                android:id="@+id/rbGooglePay"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_white_rounded"
                android:buttonTint="@color/purple_500"
                android:drawablePadding="12dp"
                android:padding="16dp"
                android:layout_marginBottom="12dp"
                android:text="Google Pay"
                android:textColor="@color/black"
                android:textSize="16sp" />

            <!-- Lựa chọn 3: Chuyển khoản (Ví dụ thêm) -->
            <RadioButton
                android:id="@+id/rbBanking"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_white_rounded"
                android:buttonTint="@color/purple_500"
                android:drawableStart="@drawable/ic_payment_2"
                android:drawablePadding="12dp"
                android:padding="16dp"
                android:text="Chuyển khoản ngân hàng / QR"
                android:textColor="@color/black"
                android:textSize="16sp" />

        </RadioGroup>
    </ScrollView>

    <!-- Nút Xác nhận -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnConfirmPayment"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="16dp"
        android:backgroundTint="#FF3B30"
        android:padding="12dp"
        android:text="Đồng ý"
        android:textColor="@color/white"
        android:textSize="16sp"
        android:textStyle="bold" />

</LinearLayout>
